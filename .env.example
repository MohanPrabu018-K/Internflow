# InternFlow — Environment Variables
# Copy this file to .env.local and fill in values for your environment.
#
# ⚠️  NEVER commit .env.local to version control!

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/internflow"

# ─── Authentication (NextAuth.js v5) ─────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (optional — https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── Email (Resend SMTP) ─────────────────────────────────────────────────────────
# Sign up at https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@internflow.com"

# SMTP fallback (if not using Resend)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── Storage ─────────────────────────────────────────────────────────────────────
# Options: "local" | "s3"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# AWS S3 (if STORAGE_PROVIDER=s3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="internflow-uploads"

# ─── Security ────────────────────────────────────────────────────────────────────
# Rate limiting
RATE_LIMIT_MAX="100"           # requests per window
RATE_LIMIT_WINDOW_SEC="60"     # window in seconds

# CSRF
CSRF_SECRET=""                 # auto-generated if empty

# ─── App ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="InternFlow"

# ─── Monitoring ──────────────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Feature Flags ───────────────────────────────────────────────────────────────
# Set to "false" to disable AI features entirely
NEXT_PUBLIC_AI_ENABLED="true"
# Enable live coding evaluation (requires judge0 or similar)
NEXT_PUBLIC_LIVE_CODING="false"
